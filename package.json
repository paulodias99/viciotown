{
  "name": "viciotown",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VicioTown — escritório virtual isométrico multiplayer (Phaser 3 + Colyseus + React)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w @viciotown/server",
    "dev:client": "npm run dev -w @viciotown/client",
    "build": "npm run build -w @viciotown/client && npm run build -w @viciotown/server",
    "start": "npm run start -w @viciotown/server",
    "typecheck": "tsc -b --pretty",
    "lint": "npm run typecheck",
    "clean": "rm -rf apps/*/dist packages/*/dist **/*.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "playwright": "^1.63.0",
    "typescript": "^5.7.3"
  }
}
