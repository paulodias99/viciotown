# ─────────────────────────────────────────────────────────────
# VicioTown — configuração. Copie para `.env` e preencha.
# Tudo aqui é OPCIONAL: sem nenhuma variável o mundo sobe em modo
# local (agenda na memória, bot determinístico, sem Slack).
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
TIMEZONE=America/Sao_Paulo

# Origens permitidas no matchmaking. `*` libera tudo (ok em dev).
CORS_ORIGINS=*

# Perfis, histórico de chat e estatísticas. `:memory:` desliga o disco.
DATABASE_PATH=./data/viciotown.db

# ─── Escala horizontal ───────────────────────────────────────
# Com Redis, vários processos compartilham salas, presença e café.
# Sem isto, tudo funciona — só num processo só.
# REDIS_URL=redis://localhost:6379

# ─── Sala Roxa (Google Calendar) ─────────────────────────────
# Sem isto, a reserva funciona com uma agenda local em memória.
# GOOGLE_CALENDAR_ID=algo@group.calendar.google.com
# GOOGLE_CREDENTIALS_FILE=./key/service-account.json
# ...ou o JSON inteiro numa variável (útil em PaaS):
# GOOGLE_CREDENTIALS_JSON={"client_email":"...","private_key":"..."}

# ─── Slack ───────────────────────────────────────────────────
# SLACK_APP_TOKEN habilita Socket Mode (não precisa de URL pública).
# Sem ele, use SLACK_SIGNING_SECRET e exponha o app na internet.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_SIGNING_SECRET=...
# SLACK_READ_CHANNEL=avisos
# SLACK_NOTIFY_CHANNEL=avisos

# ─── Bot com IA ──────────────────────────────────────────────
# Sem a chave, o bot responde por intenções (regex) usando as mesmas
# ferramentas — só não entende pedidos fora do roteiro.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
BOT_AI_DISABLED=false
BOT_NPC_ENABLED=true
